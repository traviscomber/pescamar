{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron-operational-health", "schedule": "17 * * * *" }
  ],
  "rewrites": [
    { "source": "/inicio/detalle", "destination": "/index.html" },
    { "source": "/timeline", "destination": "/index.html" },
    { "source": "/lineage", "destination": "/index.html" },
    { "source": "/lotes", "destination": "/index.html" },
    { "source": "/lotes/:receptionId", "destination": "/index.html" },
    { "source": "/edgevision", "destination": "/index.html" },
    { "source": "/organization", "destination": "/index.html" },
    { "source": "/integrations", "destination": "/index.html" },
    { "source": "/pescamar-ia", "destination": "/index.html" },
    { "source": "/comunicaciones", "destination": "/index.html" },
    { "source": "/comunicaciones/detalle", "destination": "/index.html" },
    { "source": "/auditoria", "destination": "/index.html" },
    { "source": "/observabilidad", "destination": "/index.html" },
    { "source": "/rollout", "destination": "/index.html" },
    { "source": "/floor", "destination": "/index.html" },
    { "source": "/floor/detalle", "destination": "/index.html" },
    { "source": "/pallets", "destination": "/index.html" },
    { "source": "/pallets/detalle", "destination": "/index.html" },
    { "source": "/frio", "destination": "/index.html" },
    { "source": "/frio/detalle", "destination": "/index.html" },
    { "source": "/control-regulatorio", "destination": "/index.html" },
    { "source": "/estaciones", "destination": "/index.html" },
    { "source": "/estaciones/detalle", "destination": "/index.html" },
    { "source": "/impresion-etiquetas", "destination": "/index.html" },
    { "source": "/impresion-etiquetas/detalle", "destination": "/index.html" },
    { "source": "/operacion-2025", "destination": "/index.html" },
    { "source": "/planificacion", "destination": "/index.html" },
    { "source": "/etiquetas", "destination": "/index.html" },
    { "source": "/proceso-erizo", "destination": "/index.html" },
    { "source": "/proceso-erizo/detalle", "destination": "/index.html" },
    { "source": "/proceso-erizo/grafo", "destination": "/index.html" },
    { "source": "/erizo/camara", "destination": "/index.html" },
    { "source": "/plantas", "destination": "/index.html" },
    { "source": "/plantas/:plantId", "destination": "/index.html" },
    { "source": "/identidades-plantas", "destination": "/index.html" },
    { "source": "/importaciones", "destination": "/index.html" },
    { "source": "/creditos", "destination": "/index.html" },
    { "source": "/liquidaciones", "destination": "/index.html" },
    { "source": "/despachos-ventas", "destination": "/index.html" },
    { "source": "/ordenes-venta", "destination": "/index.html" },
    { "source": "/inventario", "destination": "/index.html" },
    { "source": "/inventario/detalle", "destination": "/index.html" },
    { "source": "/inventario-materiales", "destination": "/index.html" },
    { "source": "/inventario-materiales/detalle", "destination": "/index.html" },
    { "source": "/proveedores-clientes", "destination": "/index.html" },
    { "source": "/rentabilidad", "destination": "/index.html" },
    { "source": "/rentabilidad/detalle", "destination": "/index.html" },
    { "source": "/costos-transformacion", "destination": "/index.html" },
    { "source": "/costos-transformacion/detalle", "destination": "/index.html" },

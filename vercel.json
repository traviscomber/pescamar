{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/timeline", "destination": "/index.html" },
    { "source": "/planificacion", "destination": "/index.html" },
    { "source": "/plantas", "destination": "/index.html" },
    { "source": "/plantas/:plantId", "destination": "/index.html" },
    { "source": "/importaciones", "destination": "/index.html" },
    { "source": "/operacion-2025", "destination": "/index.html" },
    { "source": "/creditos", "destination": "/index.html" },
    { "source": "/liquidaciones", "destination": "/index.html" },
    { "source": "/despachos-ventas", "destination": "/index.html" },
    { "source": "/ordenes-venta", "destination": "/index.html" },
    { "source": "/inventario", "destination": "/index.html" },
    { "source": "/costos-transformacion", "destination": "/index.html" },
    { "source": "/cierre-diario", "destination": "/index.html" },
    { "source": "/aprobaciones", "destination": "/index.html" },
    { "source": "/modulos", "destination": "/index.html" },
    { "source": "/lineas", "destination": "/index.html" },
    { "source": "/recepciones", "destination": "/index.html" },
    { "source": "/operadores", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}

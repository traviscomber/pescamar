# Persistencia relacional — Neon PostgreSQL
DATABASE_URL=

# OpenAI Vision documental — sólo servidor
OPENAI_API_KEY=
# Opcional. Si se omite, se usa el modelo definido por la aplicación.
OPENAI_VISION_MODEL=

# Pescamar IA — Vercel AI Gateway. En Vercel también puede usar OIDC administrado.
AI_GATEWAY_API_KEY=

# Supervisión operacional programada — sólo servidor.
# Vercel Cron envía este valor como Bearer token al endpoint protegido.
CRON_SECRET=

# Ingesta WhatsApp Intelligence — sólo servidor.
# Debe coincidir con el secreto configurado en la URL del webhook del proveedor.
WHATSAPP_WEBHOOK_SECRET=

# Bootstrap de primer administrador — sólo servidor, mínimo 24 caracteres.
# No se usa como credencial cotidiana.
ADMIN_SETUP_TOKEN=

# Escape temporal de contingencia. Mantener false/ausente en producción normal.
AUTH_BYPASS=false

# Plant Execution: gate explícito para toda escritura de estación/packing.
# Mantener false/ausente hasta demostrar que el preview usa una rama Neon aislada.
PLANT_EXECUTION_WRITES_ENABLED=false

# Archivos originales si se habilita Vercel Blob privado para una fuente específica.
BLOB_READ_WRITE_TOKEN=
